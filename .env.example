# Local-development template for every environment variable this project reads.
# Copy to .env.local and fill in real values. Never commit real credentials.
# Deployed values live in AWS Secrets Manager; the key template is
# infra/environments/example/secret.template.json (playbook/09-uat-secret.md).
#
# WHICH FILE GOES WHERE
#   .env.local              local development (pnpm dev, pnpm run mcp:dev)
#   AWS Secrets Manager     UAT and production ECS runtime configuration
#
# Do not create a filled .env.production for deployment. ECS injects each key
# into the containers from the environment's Secrets Manager secret; the key
# lists live in infra/modules/environment/variables.tf (web_secret_keys and
# mcp_secret_keys). A key that is not in those lists never reaches a container.
#
# Variables marked [ENV-SPECIFIC] MUST differ between local and deployed
# environments. Copying them verbatim to a deployed environment breaks OAuth,
# because the redirect URIs would still point at localhost.
#
# HOW THESE GET LOADED — three different mechanisms, easy to trip over:
#   - SvelteKit/Vite (pnpm dev, pnpm build) loads the matching .env file
#     automatically.
#   - The Prisma CLI (pnpm run db:*) does NOT — prisma.config.ts explicitly
#     calls process.loadEnvFile('.env.local'), guarded by existsSync so it
#     still works in CI/ECS where no dotenv file exists.
#   - Standalone tsx scripts and the MCP process load .env.local explicitly
#     because they run outside SvelteKit and the Prisma CLI.
# A new script that touches the database outside these paths needs the same
# explicit load.
#
# `pnpm run test` treats every uncommented key in THIS file as required and
# fails if .env.local lacks one. Keep optional keys commented out here.

# --- Database (Prisma + PostgreSQL) --------------------------------------
# Server-only. Never expose as PUBLIC_* or send to browser-reachable code.
# Reserved characters in the password (# ? | @ /) must be percent-encoded.
DATABASE_URL=<local_postgresql_connection_string>

# --- Google Workspace OAuth (staff login) --------------------------------
# From Google Cloud Console → APIs & Services → Credentials (OAuth client ID,
# type "Web application").
GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>
# [ENV-SPECIFIC] localhost for dev; the environment's HTTPS URL when deployed.
# Every value must be registered on the same Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Comma-separated list of Google Workspace domains allowed to log in, checked
# against Google's signed `hd` ID-token claim (never the email string alone).
# No default on purpose.
#
# WARNING: this is a lock-everyone-out setting. If no allowed domain matches
# the account you sign in with, nobody can log in and there is no other door.
# Include the development team's domain while building; review before handoff.
GOOGLE_ALLOWED_DOMAIN=__GOOGLE_ALLOWED_DOMAIN__
# Auto-granted the ADMIN role plus every MCP scope on this email's first-ever
# Google login only — not reapplied on later logins, so it stays genuinely
# revocable like any other admin grant. This is how the very first admin gets
# into /admin with no admin already existing. Must be in an allowed domain.
INITIAL_ADMIN_EMAIL=<first_admin_google_email>

# --- MCP server -------------------------------------------------------------
# LEGACY / OPTIONAL. A single shared bearer token with unrestricted access to
# every registered tool, not attributable to anyone and only revocable by
# changing this variable and redeploying.
#
# Prefer per-agent tokens created in /admin?screen=agents instead: those are
# named, individually scoped, revocable from the UI, and show up in the audit
# log. Leave this unset unless an environment needs a break-glass credential.
# MCP_SERVER_TOKEN=<optional_legacy_break_glass_token>

# Public URL of the MCP endpoint served by the standalone mcp-server process
# (src/mcp-server/index.ts). Also the `resource` value in
# .well-known/oauth-protected-resource. In local dev this is a different
# origin/port than MCP_OAUTH_ISSUER_URL (mcp-server on :3001 vs the SvelteKit
# app on :5173) since they are two separate local processes. When deployed
# they share one hostname: MCP_PUBLIC_URL includes `/api/mcp`, while
# MCP_OAUTH_ISSUER_URL is the web application's origin. The ALB routes the
# exact MCP path to the mcp-server and everything else to SvelteKit.
# [ENV-SPECIFIC] localhost:3001/api/mcp for dev; the shared deployment URL in UAT/prod.
MCP_PUBLIC_URL=http://localhost:3001/api/mcp

# What the standalone mcp-server process binds to — not what MCP_PUBLIC_URL
# advertises. Both default to these exact values in code; the deployed images
# bake them in as Dockerfile ENV (web 3000, mcp 3001), never in the secret.
PORT=3001
HOST=0.0.0.0

# --- MCP OAuth (remote AI-client connector) -------------------------------
# This server's own OAuth issuer identity — used in discovery metadata and to
# validate tokens it issues. Always the SvelteKit app's origin: authorize,
# token, consent and .well-known live there, not in the standalone mcp-server.
# [ENV-SPECIFIC] localhost for dev; the environment's HTTPS origin when
# deployed. Unlike MCP_PUBLIC_URL, this value has no `/api/mcp` suffix.
MCP_OAUTH_ISSUER_URL=http://localhost:5173
# Space-delimited wire names of the scopes this server's authorization
# endpoint advertises. Must be a subset of src/lib/server/mcp/scopes.ts.
MCP_OAUTH_SCOPES=data:read reports:read

# --- Local dev bypass login (never enabled in production) -----------------
# OPTIONAL. When both DEV_LOGIN_ENABLED=true AND NODE_ENV!=production, the
# /login page shows a "Dev bypass sign-in" button and POST /api/auth/dev-login
# mints a real session for a local admin user (DEV_LOGIN_EMAIL, defaults to
# dev@localhost.dev). Skips Google entirely — useful before Google OAuth is
# configured. The route 404s in production regardless of the flag.
# DEV_LOGIN_ENABLED=true
# DEV_LOGIN_EMAIL=dev@localhost.dev

# --- Email (Admin > Users > Invite a user) -----------------------------------
# OPTIONAL. src/lib/server/email.ts calls Resend's plain HTTP API directly (no
# SDK dependency). Without both set, inviting a user still creates their
# account as INVITED and shows a copyable sign-in link instead of sending mail.
# EMAIL_FROM must be a domain verified at resend.com.
# RESEND_API_KEY=<resend_api_key>
# EMAIL_FROM=<verified_sender_email>
