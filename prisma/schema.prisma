generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  displayName           String?
  status                UserStatus             @default(INVITED)
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditEvents           AuditEvent[]           @relation("AuditActor")
  accounts              AuthAccount[]
  sessions              AuthSession[]
  mcpTokens             McpAccessToken[]
  mcpAuthorizationCodes McpAuthorizationCode[]
  mcpRefreshTokens      McpRefreshToken[]
  mcpScopes             McpUserScopeGrant[]
  roles                 UserRole[]
}

model AuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String     @id @default(cuid())
  name        RoleName   @unique
  description String?
  users       UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([bucketKey, windowStart])
}

model McpOAuthClient {
  id                      String                    @id @default(cuid())
  clientId                String                    @unique
  clientSecretHash        String?
  clientName              String?
  redirectUris            String[]
  tokenEndpointAuthMethod String                    @default("none")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  disabledAt              DateTime?
  accessTokens            McpAccessToken[]
  authorizationCodes      McpAuthorizationCode[]
  authorizationRequests   McpAuthorizationRequest[]
  refreshTokens           McpRefreshToken[]

  @@index([disabledAt])
}

model McpAuthorizationRequest {
  id                  String                        @id @default(cuid())
  clientId            String
  redirectUri         String
  clientState         String
  codeChallenge       String
  codeChallengeMethod String
  scope               String
  userId              String?
  status              McpAuthorizationRequestStatus @default(PENDING)
  createdAt           DateTime                      @default(now())
  expiresAt           DateTime
  client              McpOAuthClient                @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model McpAuthorizationCode {
  id                  String         @id @default(cuid())
  codeHash            String         @unique
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  scope               String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime       @default(now())
  client              McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
}

model McpRefreshToken {
  id            String         @id @default(cuid())
  tokenHash     String         @unique
  clientId      String
  userId        String
  scope         McpScope[]
  familyId      String
  rotatedFromId String?
  revokedAt     DateTime?
  expiresAt     DateTime
  lastUsedAt    DateTime?
  createdAt     DateTime       @default(now())
  client        McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model McpAccessToken {
  id         String         @id @default(cuid())
  tokenHash  String         @unique
  clientId   String
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())
  scope      McpScope[]
  client     McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A non-interactive machine credential: an automation, service, or agent with no
/// human user behind it. Unlike McpAccessToken, its scopes are its own (there is no
/// McpUserScopeGrant to intersect against), but it is still individually named,
/// scoped, revocable, and attributable in the audit log.
model AgentToken {
  id          String     @id @default(cuid())
  name        String
  description String?
  tokenHash   String     @unique
  tokenPrefix String
  scope       McpScope[]
  createdBy   String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedBy   String?
  lastUsedAt  DateTime?

  @@index([revokedAt])
}

model McpUserScopeGrant {
  id        String    @id @default(cuid())
  userId    String
  scope     McpScope
  grantedAt DateTime  @default(now())
  grantedBy String?
  revokedAt DateTime?
  revokedBy String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope])
  @@index([userId])
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RoleName {
  ADMIN
  STAFF
  VIEWER
}

/// The data scopes an admin can grant. Two neutral examples ship with the template;
/// rename or extend them for the client's domain. Keeping this an enum (rather than a
/// table) means a missed scope check is a compile-time error in every switch over it.
/// Wire names (`data:read`) live in src/lib/server/mcp/scopes.ts.
enum McpScope {
  DATA_READ
  REPORTS_READ
  SCHEDULE_READ
  IMPORT_WRITE
  SCHEDULE_WRITE
  ORDERS_READ
}

enum McpAuthorizationRequestStatus {
  PENDING
  AWAITING_CONSENT
  GRANTED
  DENIED
  EXPIRED
}

// --- One Off Apparel scheduling domain -------------------------------------
// Canonical storage for the domain described in CLAUDE.md's "Domain: One Off
// Apparel Scheduling System" section. Schema, field meanings and the
// depends_on / sequence_order split are specified there — read it before
// changing any of the models below.

model Order {
  id                     String                 @id @default(cuid())
  hoopsOrderId           String                 @unique
  customerName           String
  externalShipDate       DateTime               @db.Date
  internalDueDate        DateTime               @db.Date
  status                 OrderStatus            @default(NEEDS_REVIEW)
  blankOrderingStatus    BlankOrderingStatus    @default(NOT_ORDERED)
  customerApprovalStatus CustomerApprovalStatus @default(NOT_SENT)
  importedBy             String
  createdAt              DateTime               @default(now())
  // Free-text, human-entered — e.g. why a job ran late. Not written by any engine or
  // MCP tool; only a person (or a correction applied through updateOrderFields) sets
  // this. Surfaced in Reports next to late orders. See CLAUDE.md's Known open items for
  // the still-undecided recurring-digest idea this was requested alongside.
  notes                  String?
  // Scheduler UI overrides — a shop can rename an order and pick a color for it on
  // the schedule board without touching customerName / the deterministic hash
  // palette. Both optional; null means "use the default derived value"
  // (customerName for title, hash(id) for color).
  displayTitle           String?
  colorHex               String?
  lineItems              LineItem[]
}

// A physical garment with a print on the front and an embroidery on the back
// is two rows here sharing one orderId, not one row — see CLAUDE.md.
model LineItem {
  id                    String                 @id @default(cuid())
  orderId               String
  itemType              LineItemType
  design                String
  // Decoration-oriented fields: meaningful when itemType is DECORATION,
  // null on FINISHING rows.
  printLocation         PrintLocation?
  decorationType        DecorationType?
  inkColorCount         Int?
  screens               Int?
  stitchCount           Int?
  // Finishing-oriented fields: meaningful when itemType is FINISHING,
  // null on DECORATION rows.
  finishingStep         FinishingStep?
  // NEW (2026-09-21): is this a normal garment ("FLAT" — a t-shirt, hoodie, etc.) or
  // headwear ("CAP")? We added this because embroidery pricing/timing math is
  // completely different for caps vs regular garments — it's not just a different
  // number, it's a different formula. Only matters for DECORATION rows; always null
  // on FINISHING rows. See estimateHours.ts for where this actually gets used.
  garmentStyle          GarmentStyle?
  // NEW (2026-09-21): only filled in when garmentStyle is "CAP" — is the cap
  // STRUCTURED (has a stiff front panel) or UNSTRUCTURED (soft, no stiff panel)?
  // Caps use a different embroidery formula depending on this. Stays null for
  // every non-cap row.
  capConstruction       CapConstruction?
  // Either another LineItem's id, or the literal string "all_siblings"
  // (waits on every other line item under the same order). This is
  // deliberately a plain string, not a Prisma relation: a real FK
  // constraint cannot also accept the "all_siblings" sentinel. Unlocking
  // is evaluated in application code (check_completion), not the DB.
  // Do not conflate with ScheduleAssignment.sequenceOrder — that is batch
  // ordering within one station's day, this is cross-line-item dependency.
  dependsOn             String?
  status                LineItemStatus         @default(NEEDS_REVIEW)
  artworkApprovalStatus ArtworkApprovalStatus?
  weightClass           WeightClass
  apparelColor          String
  quantity              Int
  sizeBreakdown         Json
  estimatedHours        Json?
  reviewConfidence      Float?
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scheduleAssignments   ScheduleAssignment[]
  actuals               Actual[]

  @@index([orderId])
  @@index([status])
}

model Station {
  id                  String               @id @default(cuid())
  name                String               @unique
  type                String
  capacityCalendar    CapacityCalendar[]
  scheduleAssignments ScheduleAssignment[]
  actuals             Actual[]
}

model CapacityCalendar {
  stationId    String
  date         DateTime @db.Date
  availableHrs Float
  station      Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([stationId, date])
}

model ScheduleAssignment {
  id               String                   @id @default(cuid())
  lineItemId       String
  stationId        String
  date             DateTime                 @db.Date
  // Batch ordering only, within one station's day (the ATCS heuristic) —
  // not cross-step dependency. See LineItem.dependsOn.
  sequenceOrder    Int
  // Wall-clock start, minutes from midnight. Persisted so a placement dragged
  // onto a specific time (e.g. 9:30 = 570) survives reload. Nullable because
  // engine-proposed assignments only pin a date and sequence today — they don't
  // commit to a clock time until a human drags them. Do NOT conflate with
  // sequenceOrder.
  startMinuteOfDay Int?
  estimatedHours   Float
  status           ScheduleAssignmentStatus @default(PROPOSED)
  proposedBy       String?
  approvedBy       String?
  approvedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  // Optional parent draft. Null means "committed to the live schedule" (or a
  // legacy row from before drafts existed). onDelete: SetNull so deleting a
  // draft leaves any committed assignments intact.
  scheduleDraftId  String?
  scheduleDraft    ScheduleDraft?           @relation(fields: [scheduleDraftId], references: [id], onDelete: SetNull)
  lineItem         LineItem                 @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  station          Station                  @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@index([lineItemId])
  @@index([stationId])
  @@index([date])
  @@index([scheduleDraftId])
}

// Historical record of real time taken, for validating the estimate_hours
// formulas against actuals. Written when a station is marked done.
model Actual {
  id          String   @id @default(cuid())
  lineItemId  String
  stationId   String
  actualHours Float
  completedAt DateTime
  lineItem    LineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@index([lineItemId])
  @@index([stationId])
}

// A named plan for what should run during a date range — the multi-draft parent a
// shop uses to hold several candidate schedules side-by-side, pick one, and commit
// it. ScheduleAssignment.scheduleDraftId FKs here (2026-09-21) — manual placements
// (the drafts/[id] drag-and-drop workspace) and the "Create automatic schedule"
// button (proposeIntoNewDraft.ts, which runs the same propose_schedule engine the
// propose_schedule MCP tool uses) both write into it. The MCP tool's own direct
// path (proposeAndPersistSchedule.ts) still writes un-drafted PROPOSED rows, by
// design — see its doc comment.
model ScheduleDraft {
  id          String               @id @default(cuid())
  name        String
  description String?
  startDate   DateTime             @db.Date
  weeks       Int
  strategy    ScheduleStrategy     @default(BATCH_OPTIMIZE)
  status      ScheduleDraftStatus  @default(DRAFT)
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  assignments ScheduleAssignment[]

  @@index([status])
  @@index([startDate])
}

// Domain-specific audit trail for order/line-item/schedule changes. Distinct
// from the platform's generic AuditEvent (admin activity log) — see the
// open question recorded in CLAUDE.md about whether these should merge.
model DomainAuditLog {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  action   String
  actor    String
  diff     Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}

enum OrderStatus {
  NEEDS_REVIEW
  CONFIRMED
  SCHEDULED
  IN_PRODUCTION
  COMPLETE
  // NEW (2026-09-21): this is what "deleting" an order actually does — we never
  // remove the row from the database. Instead we just flip its status to
  // CANCELLED. Why not a real delete? Because the order might already have line
  // items, a proposed/approved schedule, or recorded actual hours attached to it,
  // and deleting the order would delete all of that too (thanks to "cascade"
  // rules on the foreign keys) — wiping out real production history. Setting
  // status to CANCELLED instead just makes the order disappear from the active
  // Orders list and stop showing up as something that can be scheduled, while
  // everything about it stays in the database if anyone needs to look back at
  // it later. See cancelOrder.ts for the code that does this.
  CANCELLED
}

enum LineItemType {
  DECORATION
  FINISHING
}

enum PrintLocation {
  FRONT
  BACK
  LEFT
  RIGHT
}

enum DecorationType {
  SCREEN_PRINT
  EMBROIDERY
  DTF
  DTG
}

enum FinishingStep {
  MATTE
  RELABEL
  FOLD_BAG
  HANG_TAG
}

enum LineItemStatus {
  NEEDS_REVIEW
  BLOCKED
  IN_PRODUCTION
  COMPLETE
}

enum WeightClass {
  THIN
  POLY
  BULKY
}

// NEW (2026-09-21): the two "shapes" of thing we decorate. A regular garment
// (t-shirt, hoodie, sweatshirt...) is FLAT. A hat/beanie/etc. is CAP — caps get
// hooped and sewn differently on the embroidery machine, so they need their own
// formula instead of reusing the FLAT one.
enum GarmentStyle {
  FLAT
  CAP
}

// NEW (2026-09-21): only relevant when GarmentStyle is CAP. A STRUCTURED cap has
// a stiffened front panel; an UNSTRUCTURED cap doesn't. This changes how long the
// embroidery machine setup takes.
enum CapConstruction {
  STRUCTURED
  UNSTRUCTURED
}

enum ScheduleAssignmentStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETE
}

enum ScheduleStrategy {
  BATCH_OPTIMIZE
  STRICT_DUE_DATE
}

enum ScheduleDraftStatus {
  DRAFT
  PROPOSED
  APPROVED
  ARCHIVED
}

enum ArtworkApprovalStatus {
  NOT_SUBMITTED
  PENDING_APPROVAL
  REVISION_REQUESTED
  APPROVED
}

enum BlankOrderingStatus {
  NOT_ORDERED
  ORDERED
  ISSUE
  RECEIVED
}

enum CustomerApprovalStatus {
  NOT_SENT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
}
