{
	"name": "ooa",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "svelte-kit sync && prisma generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "tsx scripts/test.ts",
		"db:generate": "prisma generate",
		"db:format": "prisma format",
		"db:validate": "prisma validate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"mcp:dev": "tsx src/mcp-server/index.ts",
		"template:check": "bash scripts/template-check.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"jose": "^6.2.12",
		"pg": "^8.23.1",
		"prisma": "^7.10.0",
		"zod": "^4.6.5"
	},
	"description": "One Off Apparel: SvelteKit + Prisma/PostgreSQL + read-only MCP server + Terraform ECS Fargate."
}
