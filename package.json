{
	"name": "client-platform-template",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "svelte-kit sync && prisma generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "tsx scripts/test.ts",
		"db:generate": "prisma generate",
		"db:format": "prisma format",
		"db:validate": "prisma validate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"mcp:dev": "tsx src/mcp-server/index.ts",
		"template:check": "bash scripts/template-check.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.5.1",
		"@types/pg": "^8.23.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"jose": "^6.2.12",
		"pg": "^8.23.0",
		"prisma": "^7.10.0",
		"zod": "^4.6.2"
	},
	"description": "Template: SvelteKit + Prisma/PostgreSQL + standalone read-only MCP server (OAuth 2.1) + Terraform ECS Fargate + build-once/promote-unchanged pipeline. Run scripts/init-template.sh after generating a repo from it."
}
