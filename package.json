{
	"name": "ooa",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "svelte-kit sync && prisma generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "tsx scripts/test.ts",
		"db:generate": "prisma generate",
		"db:format": "prisma format",
		"db:validate": "prisma validate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"mcp:dev": "tsx src/mcp-server/index.ts",
		"template:check": "bash scripts/template-check.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.2",
		"@types/pg": "^8.20.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"jose": "^6.2.8",
		"pg": "^8.22.0",
		"prisma": "^7.9.1",
		"zod": "^4.4.3"
	},
	"description": "One Off Apparel: SvelteKit + Prisma/PostgreSQL + read-only MCP server + Terraform ECS Fargate."
}
